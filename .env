# Worthify — Environment Configuration
# ─────────────────────────────────────────────────────────────────────
# SECURITY NOTE: This file contains sensitive configuration.
# Never commit real production secrets to public repositories.
# In production, use environment variables or a secrets manager.
# ─────────────────────────────────────────────────────────────────────

# Flask / JWT
SECRET_KEY=worthify-flask-secret-2024-change-in-production
JWT_SECRET_KEY=worthify-ultra-secret-2024-key-change-in-production

# App Config
FLASK_ENV=development
FLASK_DEBUG=0
PORT=3000

# External APIs (replace with real keys for production)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# OPENAI_API_KEY=your-openai-key-here         # (optional) for AI-enhanced verdicts
# SERPAPI_KEY=your-serpapi-key-here           # (optional) for real Google Shopping data
# SCRAPER_API_KEY=your-scraper-api-key-here   # (optional) for bypassing anti-bot protection

# Database (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/worthify
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting
MAX_ANALYSES_PER_USER_PER_DAY=50
RATE_LIMIT_WINDOW_MINUTES=60

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://worthify.pages.dev
